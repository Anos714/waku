# Waku environment variables

# Public origin of this instance, e.g. https://waku.example.com. Used as the
# metadata base so relative URLs (/opengraph-image, /site.webmanifest) resolve
# to absolute ones for social previews. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini (Google AI) API key — server-side only. Used by app/api/ai/bio/route.ts
# Generate one at https://aistudio.google.com/app/apikey
# The AI bio/tagline generator gracefully reports a configuration error when this is missing.
GEMINI_API_KEY=

# Optional: override the model used for generation (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: the ordered list of models tried when the AI writer hits a busy
# model. Generation falls gemini-3.8-flash -> gemini-3.5-flash -> gemini-3.7-flash
# and only reports "all models busy" if every one is overloaded. Override with a
# comma-separated list for a key whose models differ. Run `pnpm ai:models` to
# see what this key can actually reach.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.7-flash

# Cloudinary — server-side only. Used by app/api/upload/route.ts for profile
# photo uploads. Find these in your Cloudinary console's "API keys" page.
# The upload route reports a clear configuration error when these are missing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary cloud name, exposed to the browser. Required to build AVIF/WebP
# delivery URLs from a stored public ID (see lib/profile/avatar-delivery.ts).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Neon Postgres — server-side only. Used by lib/db.ts to publish and read
# public profiles at /p/[slug]. Get a connection string from your Neon dashboard.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth — server-side only. Signs the cookie-based sessions used to gate
# publishing. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BETTER_AUTH_SECRET=
# Public base URL of this instance (http://localhost:3000 in dev). Better Auth
# checks it against the sign-in request's origin.
BETTER_AUTH_URL=http://localhost:3000

# Social sign-in providers — server-side only. Register an OAuth app per provider
# and paste its credentials here to enable "Sign in to publish" in the editor.
# Providers left blank are hidden from the sign-in UI rather than erroring.
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


